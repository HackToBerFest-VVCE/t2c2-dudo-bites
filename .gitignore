version: '3.9'
services:
  postgres:
    image: postgres:16-alpine
    container_name: duobites-postgres
    restart: unless-stopped
    environment:
      POSTGRES_DB: duobites
      POSTGRES_USER: duobites
      POSTGRES_PASSWORD: duobites
    ports:
      - "5432:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data

volumes:
  postgres_data:
